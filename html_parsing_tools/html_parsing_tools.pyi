from collections.abc import Sequence

class GetSentencesResult:
    @property
    def descriptions(self) -> list[str]: ...
    @property
    def h(self) -> dict[str, list[str]]: ...
    @property
    def json_ld(self) -> list[str]: ...
    @property
    def keywords(self) -> str: ...
    @property
    def other(self) -> list[str]: ...
    @property
    def p(self) -> list[str]: ...
    @property
    def text_nodes(self) -> list[list[str]]: ...
    @property
    def meta_titles(self) -> dict[str, str]: ...
    @property
    def href_attributes(self) -> list[str]: ...

class ParsedPage:
    def get_anchor_links(self) -> list[tuple[str, str]]: ...
    def get_link_attributes(self) -> list[str]: ...
    def get_link_elements(self) -> list[tuple[str, str, dict[str, str]]]: ...
    def get_script_contents(self) -> list[str]: ...
    def get_meta_tags(self) -> list[tuple[str, str]]: ...
    def get_json_ld(self) -> list[str]: ...
    def get_anchor_text_fragments(self) -> list[tuple[str | None, list[str]]]: ...
    def get_script_texts(self) -> list[tuple[str, str]]: ...
    def get_elements(self) -> list[tuple[str, dict[str, str]]]: ...

def get_emails(html: str) -> list[str]: ...
def get_links(html: str) -> list[tuple[str, str]]: ...
def html_contents(html: str) -> str: ...
def tag_html_contents(html: str, tag: str) -> str: ...
def tag_attribute(html: str, tag: str, attribute: str) -> str: ...
def get_sentences(
    html: str,
    /,
    *,
    stop_word: str,
    remove_header: bool,
    remove_footer: bool,
    add_text_nodes: bool,
    min_split_for_text_nodes: int | None,
) -> GetSentencesResult: ...
def get_sentences_parallel(
    htmls: Sequence[str],
    /,
    *,
    stop_word: str,
    remove_header: bool,
    remove_footer: bool,
    add_text_nodes: bool,
    min_split_for_text_nodes: int | None,
) -> list[GetSentencesResult]: ...
def get_markdown(
    html: str, /, *, stop_word: str, remove_header: bool, remove_footer: bool
) -> str: ...
def get_markdown_parallel(
    htmls: Sequence[str], /, *, stop_word: str, remove_header: bool, remove_footer: bool
) -> list[str]: ...
def get_href_attributes(html: str) -> list[str]: ...
def get_alternate_links(html: str) -> dict[str, list[str]]: ...
def get_lang(html: str) -> str: ...
def get_meta_titles(html: str) -> dict[str, str]: ...
def regularize(text: str) -> str: ...
def split_sentence(
    sentence: str,
    /,
    *,
    split_re: str | None = None,
    split_words: set[str] | frozenset[str] | None = None,
) -> list[str]: ...
def form_text_nodes(
    text_elements: Sequence[str], min_split: int | None = None
) -> list[list[str]]: ...
def extract_text(
    html: str, /, *, min_split: int | None = None
) -> dict[str, list[list[str]]]: ...
def remove_matching_links(html: str, texts: Sequence[str]) -> str: ...
def strip_buttons_and_get_text(html: str) -> str: ...
def load_page(html: str) -> ParsedPage: ...
