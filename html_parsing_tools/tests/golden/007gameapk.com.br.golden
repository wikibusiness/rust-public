[("\n    {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"WebSite\",\n        \"name\": \"007game\",\n        \"url\": \"http://www.007gameapk.com.br/\",\n        \"description\": \"A 007game é cassino e apostas online no Brasil. Depósito e saque via Pix na hora, bônus de cadastro e milhares de jogos. Cadastre-se na 007game e comece a ganhar.\",\n        \"logo\": \"007game_logo.webp\",\n        \"image\": {\n            \"@type\": \"ImageObject\",\n            \"url\": \"007game.webp\"\n        }\n    }\n    ", ""), ("", "/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"), ("\n    {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"Casino\",\n        \"name\": \"007game\",\n        \"url\": \"http://www.007gameapk.com.br/\",\n        \"logo\": {\n            \"@type\": \"ImageObject\",\n            \"url\": \"http://www.007gameapk.com.br/007game_logo.webp\",\n            \"width\": 100,\n            \"height\": 100\n        },\n        \"image\": {\n            \"@type\": \"ImageObject\",\n            \"url\": \"http://www.007gameapk.com.br/007game.webp\",\n            \"width\": 582,\n            \"height\": 582\n        },\n        \"description\": \"A 007game é uma das principais plataformas de cassino online no Brasil, oferecendo uma experiência de jogo completa e segura. Com uma vasta seleção de jogos que incluem crash games emocionantes, caça-níqueis, jogos de mesa clássicos e muito mais, garantimos diversão e entretenimento de alta qualidade.\",\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"addressCountry\": \"BR\"\n        },\n        \"aggregateRating\": {\n            \"@type\": \"AggregateRating\",\n            \"ratingValue\": \"4.8\",\n            \"reviewCount\": \"1250\",\n            \"bestRating\": \"5\",\n            \"worstRating\": \"1\"\n        },\n        \"priceRange\": \"R$\",\n        \"currenciesAccepted\": \"BRL\",\n        \"paymentAccepted\": \"Cartão de Crédito, PIX, Boleto, Carteira Digital\",\n        \"hasMap\": \"https://www.google.com/maps/search/?api=1&query=Brazil\",\n        \"telephone\": \"+55-800-000-0000\",\n        \"email\": \"suporte@007gamepelada.com\",\n        \"sameAs\": [\n            \"https://www.facebook.com/007game\",\n            \"https://www.instagram.com/007game\",\n            \"https://twitter.com/007game\"\n        ],\n        \"openingHours\": \"Mo-Su 00:00-24:00\",\n        \"geo\": {\n            \"@type\": \"GeoCoordinates\",\n            \"latitude\": \"-14.2350\",\n            \"longitude\": \"-51.9253\"\n        },\n        \"areaServed\": {\n            \"@type\": \"Country\",\n            \"name\": \"Brazil\"\n        },\n        \"game\": [\n            {\n                \"@type\": \"Game\",\n                \"name\": \"Slots\",\n                \"gameLocation\": \"http://www.007gameapk.com.br/slot\"\n            },\n            {\n                \"@type\": \"Game\",\n                \"name\": \"Crash Games\",\n                \"gameLocation\": \"http://www.007gameapk.com.br/jogos\"\n            },\n            {\n                \"@type\": \"Game\",\n                \"name\": \"Jogos de Mesa\",\n                \"gameLocation\": \"http://www.007gameapk.com.br/cassino\"\n            }\n        ],\n        \"offers\": {\n            \"@type\": \"Offer\",\n            \"name\": \"Bônus de Boas-Vindas\",\n            \"description\": \"Bônus de registro de até R$ 100 + 100 giros grátis\",\n            \"price\": \"0\",\n            \"priceCurrency\": \"BRL\",\n            \"availability\": \"https://schema.org/InStock\",\n            \"url\": \"http://www.007gameapk.com.br/\"\n        },\n        \"legalName\": \"007game\",\n        \"foundingDate\": \"2020\",\n        \"numberOfEmployees\": {\n            \"@type\": \"QuantitativeValue\",\n            \"value\": \"150\"\n        }\n    }\n    ", ""), ("", "https://static.cloudflareinsights.com/beacon.min.js/vcd15cb