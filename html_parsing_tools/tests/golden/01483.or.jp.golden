=== ParsedPage.get_meta_tags ===
[("viewport", "width=device-width, initial-scale=1"), ("description", "芦屋市（阪急神戸本線「芦屋川駅」）の内科、外科の永松クリニックです。自宅のリビングに居るような落ち着いた雰囲気でリラックスして診察を受けていただけます。消化器科、外科、内科、麻酔科、レントゲン科など様々な症状に対応しております。"), ("keywords", "永松クリニック,芦屋市,内科,外科,在宅診療,プラセンタ"), ("og:title", "永松クリニック｜芦屋市の外科・内科｜様々な検査で予防に力を入れています"), ("og:type", "website"), ("og:url", "https://www.01483.or.jp/"), ("og:image", "https://www.01483.or.jp/wp-content/uploads/logo_ogp.jpg"), ("og:site_name", "永松クリニック"), ("og:description", "芦屋市（阪急神戸本線「芦屋川駅」）の内科、外科の永松クリニックです。自宅のリビングに居るような落ち着いた雰囲気でリラックスして診察を受けていただけます。消化器科、外科、内科、麻酔科、レントゲン科など様々な症状に対応しております。"), ("og:image:secure_url", "https://www.01483.or.jp/wp-content/uploads/logo_ogp.jpg"), ("twitter:card", "summary"), ("twitter:title", "永松クリニック｜芦屋市の外科・内科｜様々な検査で予防に力を入れています"), ("twitter:description", "芦屋市（阪急神戸本線「芦屋川駅」）の内科、外科の永松クリニックです。自宅のリビングに居るような落ち着いた雰囲気でリラックスして診察を受けていただけます。消化器科、外科、内科、麻酔科、レントゲン科など様々な症状に対応しております。"), ("twitter:image", "https://www.01483.or.jp/wp-content/uploads/logo_ogp.jpg")]

