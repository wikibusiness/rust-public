        :root {
            --primary-color: #33aff7;
            --page-bg: #f0ecec;
            --block-bg: #33aff7; 
            --card-bg: #ffffff;   
            --tab-container-bg: #ffffff;
            --tab-active-bg: #33aff7;
            --tab-active-text: #ffffff;
            --tab-inactive-bg: #f0ecec;
            --tab-inactive-text: #fa501d;
            --title-color: #33aff7;
            --title-text-color: #060706;
            --border-color: #bfbdbd;
            --text-color: #333333;
            --top-header-bg: #33aff7;
            --top-header-text: #fa501d;
        }

        div[style*="var(--title-color"] {
            color: var(--title-text-color) !important;
            height: 44px !important;            
            padding: 0 10px !important;         
            display: flex !important;           
            align-items: center !important;     
            justify-content: center !important; 
            font-size: clamp(14px, 5.5vw, 24px) !important; 
            font-weight: 900 !important;        
            letter-spacing: 1px !important;     
            box-sizing: border-box !important;
            overflow: hidden !important;
            white-space: nowrap !important;
            text-overflow: ellipsis !important;
        }

        div[style*="var(--title-color"] * {
            white-space: nowrap !important;
            font-size: inherit !important;
        }

        body { margin: 0; padding: 0; font-family: -apple-system, sans-serif; background: var(--page-bg); min-height: 100vh; display: flex; justify-content: center; }
        .main-wrapper { width: 100%; max-width: 720px; min-height: 100vh; display: flex; flex-direction: column; background: var(--page-bg); }

        .sticky-container { position: -webkit-sticky; position: sticky; top: 0; z-index: 999; background: var(--page-bg); box-shadow: 0 4px 10px rgba(0,0,0,0.06); }
        .header-bar { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; background: var(--top-header-bg); border-bottom: 1px solid var(--border-color); }
        .logo-area { font-size: 26px; font-weight: bold; color: var(--top-header-text); letter-spacing: 1px; display: flex; align-items: center; }
        .header-ad { height: 42px; border-radius: 4px; display: block; }
        
        .tab-container { display: flex; align-items: center; background: var(--tab-container-bg); padding: 0 1px; gap: 2px; border-bottom: 1px solid var(--border-color); margin-bottom: 0; height: 44px; box-sizing: border-box; }
        .tab-btn { flex: 1; display: flex; align-items: center; justify-content: center; height: 42px; font-size: 26px; font-weight: bold; color: var(--tab-inactive-text); background: var(--tab-inactive-bg); border-radius: 999px; cursor: pointer; border: 1px solid var(--border-color); transition: all 0.2s; box-sizing: border-box; }
        .tab-btn.active { background: var(--tab-active-bg); color: var(--tab-active-text); border-color: var(--tab-active-bg); }
        
        .tab-icon { height: 28px; width: auto; margin-right: 6px; display: block; }
        
        .iframe-container { width: 100%; flex: 1; background: var(--page-bg); }
        .iframe-container iframe { width: 100%; border: none; display: block; overflow: hidden; min-height: 800px; }

        @media (max-width: 540px) {
            .logo-area { font-size: 24px; }
            .header-ad { height: 38px; }
            .header-bar { padding: 5px 8px; }
            .tab-btn { font-size: 22px; }
            .tab-icon { height: 24px; margin-right: 5px; }
        }
        @media (max-width: 480px) {
            .logo-area { font-size: 22px; }
            .header-ad { height: 36px; }
            .tab-btn { font-size: 20px; }
            .tab-icon { height: 22px; margin-right: 4px; }
        }
        @media (max-width: 375px) {
            .tab-btn { font-size: 18px; }
            .tab-icon { height: 20px; margin-right: 3px; }
        }
    




    
        
            
                
                    
                
            
            
        
        
        
        
        
        
            
