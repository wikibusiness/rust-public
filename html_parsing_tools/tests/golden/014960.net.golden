    function switchTab(type, element) {
        document.getElementById('content-iframe').src = '/feed/' + type;
        
        if (type === 'macau') {
            document.getElementById('header-ad-img').src = '/static/img/am_gw.png';
        } else {
            document.getElementById('header-ad-img').src = '/static/img/hk_gw.png';
        }

        var tabs = document.getElementsByClassName('tab-btn');
        for (var i = 0; i < tabs.length; i++) {
            tabs[i].classList.remove('active');
        }
        element.classList.add('active');

        if (type === 'macau') {
            document.getElementById('lottery-header-macau').style.display = 'block';
            document.getElementById('lottery-header-hk_hidden').style.display = 'none';
        } else {
            document.getElementById('lottery-header-macau').style.display = 'none';
            document.getElementById('lottery-header-hk_hidden').style.display = 'block';
        }
    }
    window.addEventListener('message', function(event) {
        if (event.data && event.data.type === 'iframe-resize') {
            document.getElementById('content-iframe').style.height = event.data.height + 'px';
        }
    });





