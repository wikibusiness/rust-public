[("keyword", "日帰り温泉,温泉,風呂,野湯,野天,露天,混浴,混浴露天風呂,温泉旅行,全国,旅行,ドライブ,観光,Googleマップ"), ("description", "全国にある日帰り温泉施設をGoogleマップを利用して紹介するサイトです。日帰り入浴が利用できる旅館から混浴露天風呂まで。温泉探すなら全国日帰り温泉マップ"), ("og:description", "日帰り入浴が利用できる旅館から混浴露天風呂までを網羅。旅先でも探せる『iOS、Androidアプリ』を配信中。ダウンロードバナーから、アクセスできます。全国日帰り温泉マップで、温泉ライフを満喫しよう！"), ("og:type", "article"), ("fb:admins", "100000918510753"), ("apple-itunes-app", "app-id=488097290"), ("og:image", "https://onsen.mobi/img/fblink.png"), ("og:site_name", "全国日帰り温泉マップ"), ("og:title", "全国日帰り温泉マップ"), ("og:country-name", "JAPAN"), ("og:url", "https://onsen.mobi/"), ("twitter:card", "summary_large_image"), ("twitter:title", "全国日帰り温泉マップ"), ("twitter:description", "全国にある日帰り温泉施設をご紹介！！"), ("twitter:image:src", "https://onsen.mobi/img/fblink.png")]

