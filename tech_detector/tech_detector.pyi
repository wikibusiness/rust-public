from collections.abc import Sequence

class TechDetector:
    def __init__(self, json_data: bytes, chunk_size: int = 28) -> None: ...
    def detect_full(
        self,
        html_parts: Sequence[Sequence[int]],
        script_parts: Sequence[Sequence[int]],
        headers: Sequence[dict[str, str]],
        cookies: Sequence[dict[str, str]],
        meta_tags: Sequence[dict[str, str]],
        include_dependencies: bool = True,
    ) -> list[str]: ...
    def resolve_dependencies(self, names: Sequence[str]) -> list[str]: ...
    def detect_text_key(
        self, key: str, parts: Sequence[Sequence[int]]
    ) -> list[str]: ...
    def detect_dict_key(self, key: str, data: dict[str, str]) -> list[str]: ...
    def pattern_counts(self) -> dict[str, int]: ...
    def skipped_patterns(self) -> list[str]: ...
